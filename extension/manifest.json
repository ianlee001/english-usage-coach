{
  "manifest_version": 3,
  "name": "语境 · YouTube 难点伴学",
  "version": "0.2.0",
  "description": "播放到难点时显示解释，并保存到你的本地英语学习单词本。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "打开英语伴学侧栏"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
