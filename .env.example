# Copy this file to .env in this project directory. Never commit real keys.
DASHSCOPE_API_KEY=
# Copy your workspace's OpenAI-compatible base URL, ending in /compatible-mode/v1.
DASHSCOPE_BASE_URL=
LLM_MODEL=qwen3.8-omni-flash
EMBEDDING_MODEL=tongyi-embedding-vision-flash

# Optional FULL native multimodal embedding endpoint.
# If empty, derive it ONLY for official dashscope / workspace maas hosts.
# Beijing legacy example:
# DASHSCOPE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
DASHSCOPE_EMBEDDING_ENDPOINT=
EMBEDDING_DIMENSIONS=768

TAVILY_API_KEY=
MINERU_TOKEN=
MINERU_MODE=precision
MINERU_LANGUAGE=en
MINERU_OCR=true

# Optional local settings (paths are resolved from this project, not the terminal).
DATA_DIR=data
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
RAG_TOP_K=5
# Conservative UTF-8 byte bound, not a token count; fits the selected model's 1024-token input.
CHUNK_BYTES=900
CHUNK_OVERLAP_BYTES=120
REQUEST_TIMEOUT=90
MINERU_TIMEOUT=300
